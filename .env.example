AFFILIATE_PORTAL_ENABLED=false
RX_STOREFRONT_ENABLED=false
RX_REFERRALS_ENABLED=false
RX_COMPANY_SLUG=america-first-clinic
AFFILIATE_PAYOUT_SETUP_ENABLED=false
AFFILIATE_PORTAL_URL=https://affiliates.govirtualhealth.com
AFFILIATE_COMPANY_SLUG=america-first-clinic

# Email
RESEND_API_KEY=
RESEND_FROM="Go Virtual Health <noreply@govirtualhealth.com>"

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
